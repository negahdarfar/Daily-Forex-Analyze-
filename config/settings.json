{
  "timezone": "Asia/Tehran",
  "report_language": "fa",
  "market_data_provider": "yahoo_finance",
  "history_period": "6mo",
  "history_interval": "1d",
  "max_quote_age_hours": 36,
  "max_daily_context_age_hours": 96,
  "schedule_utc": "30 3 * * *",
  "technical": {
    "ema_fast": 20,
    "ema_slow": 50,
    "rsi_period": 14,
    "atr_period": 14,
    "stop_atr_multiple": 1.5,
    "minimum_history_rows": 60
  },
  "ranking": {
    "technical_score_weight": 1,
    "minimum_setup_score": 55,
    "max_top_setups": 10,
    "minimum_net_rr": 2,
    "weights": {
      "technical": 25,
      "net_rr": 20,
      "fundamental": 15,
      "news": 10,
      "data_quality": 15,
      "independent_evidence": 10,
      "liquidity": 5
    }
  },
  "safety": {
    "never_label_delayed_data_as_realtime": true,
    "never_invent_missing_prices": true,
    "unverified_expert_claims_are_not_verified": true,
    "report_is_not_investment_advice": true
  },
  "news": {
    "timeout_seconds": 12,
    "max_items_per_source": 12
  },
  "official_data": {
    "timeout_seconds": 25,
    "enabled_connectors": [
      "European Central Bank",
      "World Bank",
      "US Bureau of Labor Statistics",
      "CFTC",
      "FRED"
    ],
    "notes": "BLS v1 and FRED graph CSV are keyless public data routes; CFTC PRE API is keyless but avoid overuse. FRED terms restrict use to permitted personal/non-commercial research unless separately authorized. All macro/positioning values remain contextual, not executable prices."
  },
  "risk": {
    "minimum_net_rr": 2,
    "stop_atr_buffer": 0.2,
    "mode": "research_paper_trading_only",
    "live_orders_enabled": false,
    "cost_policy": "missing_cost_is_null_and_blocks_active_status",
    "event_blackout_minutes_before": 30,
    "event_blackout_minutes_after": 30
  },
  "intraday_history_period": "60d",
  "max_intraday_quote_age_minutes": 180,
  "economic_calendar": {
    "provider": "xoomar_us_high_impact",
    "timeout_seconds": 10,
    "max_age_hours": 24,
    "scope": [
      "USD"
    ],
    "event_blackout_minutes_before": 30,
    "event_blackout_minutes_after": 30,
    "consensus_forecast_available": false
  }
}
